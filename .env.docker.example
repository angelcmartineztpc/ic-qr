# Copia a .env.production (no se versiona). Referencia completa: .env.example
APP_ORIGINS=http://localhost:3000
APP_ALLOWED_HOSTS=localhost:3000
LOG_FORMAT=json

# En producción AUTH_MODE=none hace fallar el arranque.
AUTH_MODE=basic
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD_SHA256=                      # bun run hash-password

# Almacenamiento en el volumen qr-data (para S3/R2 usa STORAGE_PROVIDER=s3, ver .env.example)
STORAGE_PROVIDER=local
ALLOW_LOCAL_STORAGE_IN_PROD=true
STORAGE_LOCAL_DIR=/app/.data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/api/storage   # dominio definitivo: queda grabado en los QR
