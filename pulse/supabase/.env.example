# Secretos de las Edge Functions: `supabase secrets set --env-file supabase/.env` (producción)
# o `supabase functions serve --env-file supabase/.env` (local). No lo versiones.

# Dominio PERMANENTE de los links de QR. https obligatorio salvo localhost. Sin barra final.
# Igual que VITE_QR_DOMAIN del frontend. Sin esto no se debe imprimir nada.
QR_PUBLIC_BASE=http://127.0.0.1:54321/functions/v1/qr-enlaces

# Orígenes de PULSE autorizados (CORS), separados por coma.
QR_ALLOWED_ORIGINS=http://localhost:5173

# Máximo de piezas por llamada de exportación (techo de CPU de Edge Functions; más se parte en lotes).
EXPORT_MAX_RECORDS=100

# Base pública de los SVG de QR (GET .../qr-resolver/storage/...). Por defecto se deduce de SUPABASE_URL, que DENTRO del
# contenedor local es http://kong:8000 (inalcanzable desde fuera): en local hay que fijarla. En producción no hace falta.
QR_STORAGE_PUBLIC_BASE=http://127.0.0.1:54321/functions/v1/qr-resolver/storage
