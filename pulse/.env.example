# Frontend (Vite). Copia a .env.local; no lo versiones.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Dominio PERMANENTE de los links de QR (/s/{código} y /qr/{resort}/{servicio}). Sin barra final.
# Se imprime en metal: debe ser definitivo antes de producir. Debe coincidir con QR_PUBLIC_BASE de supabase/.env.example.
# Local: la función qr-enlaces. Producción: un dominio propio delante de ella.
VITE_QR_DOMAIN=http://127.0.0.1:54321/functions/v1/qr-enlaces

# Solo si las funciones viven en otro host que Supabase.
# VITE_QR_FUNCTIONS_URL=
