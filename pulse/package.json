{
  "name": "pulse-modulo-qr-produccion",
  "private": true,
  "type": "module",
  "description": "Arnés Vite para desarrollar el módulo QR Producción con la estructura de PULSE. Solo src/ (salvo el arnés) y supabase/ se fusionan.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "test": "vitest run",
    "test:db": "eval \"$(supabase status -o env | sed 's/^/export /')\" && vitest run -c vitest.db.config.ts",
    "build:functions": "bun supabase/build-functions.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.561.0",
    "pdf-lib": "^1.17.1",
    "qr": "0.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.0",
    "sonner": "^2.0.0",
    "zod": "^4.6.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^30.1.2",
    "jsqr": "^1.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
