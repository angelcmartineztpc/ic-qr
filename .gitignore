# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QR Production Generator
/.data/
/playwright-report/
/test-results/
/out/
# npm es compatible pero el lockfile canónico es bun.lock (docs/ARCHITECTURE.md §D.3)
package-lock.json
# Gotham: licencia comercial, no se versiona (scripts/setup-fonts.ts)
/assets/fonts/gotham/*.otf
/assets/fonts/gotham/*.ttf
/assets/fonts/gotham/*.woff2
/assets/fonts/gotham/*.woff
# Address Sans Pro Cd (piezas): licencia de Adobe Fonts, no se versiona
/assets/fonts/address-sans/*.otf
/assets/fonts/address-sans/*.ttf
/assets/fonts/address-sans/*.woff2
/assets/fonts/address-sans/*.woff

# Libros reales para probar la importación (pueden traer datos del cliente)
/tests/fixtures/real/*.xlsx
/tests/fixtures/real/*.csv

# Cloudflare Workers (OpenNext)
.dev.vars
.open-next/
.wrangler/
